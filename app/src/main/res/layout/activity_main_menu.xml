<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <!-- Основной скролл-контент -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/contentRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/padding_screen"
            android:paddingEnd="@dimen/padding_screen"
            android:paddingTop="32dp"
            android:paddingBottom="100dp">

            <!-- Заголовок -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/title_app"
                android:textColor="@color/color_text_primary"
                android:textSize="42sp"
                android:textStyle="bold"
                android:layout_marginBottom="28dp" />

            <!-- Карточка: сложность -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/padding_card"
                android:layout_marginBottom="@dimen/margin_between">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_choose_difficulty"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <RadioGroup
                    android:id="@+id/levelGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/easyLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="@string/level_easy"
                        android:textSize="22sp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />

                    <RadioButton
                        android:id="@+id/hardLevel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/level_hard"
                        android:textSize="22sp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp" />

                </RadioGroup>
            </LinearLayout>

            <!-- Карточка: типы задач -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="@dimen/padding_card"
                android:layout_marginBottom="@dimen/margin_large">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_choose_types"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <CheckBox
                    android:id="@+id/cbAddition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/type_addition"
                    android:textSize="22sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <CheckBox
                    android:id="@+id/cbSubtraction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/type_subtraction"
                    android:textSize="22sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <CheckBox
                    android:id="@+id/cbMultiplication"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/type_multiplication"
                    android:textSize="22sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <CheckBox
                    android:id="@+id/cbDivision"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/type_division"
                    android:textSize="22sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

                <CheckBox
                    android:id="@+id/cbWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:text="@string/type_word"
                    android:textSize="22sp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp" />

            </LinearLayout>

            <!-- Кнопки действий -->
            <Button
                android:id="@+id/btnBegin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_neu_button"
                android:stateListAnimator="@null"
                android:text="@string/btn_start"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/margin_between" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnRules"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_neu_button"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_rules"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnAbout"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/button_height_small"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_neu_button"
                    android:stateListAnimator="@null"
                    android:text="@string/btn_about"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Плавающая кнопка Аа — всегда поверх контента -->

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_color">

    <LinearLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_screen"
        android:paddingEnd="@dimen/padding_screen"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Верхняя панель: Назад + статистика -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/button_height_small"
                android:background="@drawable/bg_neu_button"
                android:stateListAnimator="@null"
                android:text="@string/btn_back"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp" />

            <Space android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/livesText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_mistakes"
                    android:textColor="@color/color_wrong"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/coinsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_progress"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="18sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Карточка с задачей — занимает всё свободное пространство -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:padding="24dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/taskText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/hint_answer"
                android:textColor="@color/color_text_primary"
                android:textSize="36sp"
                android:lineSpacingMultiplier="1.3" />

        </LinearLayout>

        <!-- Поле ввода -->
        <EditText
            android:id="@+id/answerInput"
            android:layout_width="match_parent"
            android:layout_height="@dimen/input_height"
            android:background="@drawable/bg_input"
            android:gravity="center"
            android:hint="@string/hint_answer"
            android:inputType="number|numberDecimal|numberSigned"
            android:textColor="@color/color_text_primary"
            android:textColorHint="@color/color_text_hint"
            android:textSize="28sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="12dp" />

        <!-- Кнопка Проверить / Дальше -->
        <Button
            android:id="@+id/checkButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:background="@drawable/bg_neu_button"
            android:stateListAnimator="@null"
            android:text="@string/btn_check"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Плавающая кнопка Аа -->

</FrameLayout>
